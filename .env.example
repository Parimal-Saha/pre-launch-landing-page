# ─── SUGAR SHADE — environment template ─────────────────────────────
# Copy to `.env.local` for development. NEVER commit real values.
# Service-role key is server-only. NEXT_PUBLIC values are intentionally
# public and are used only for Supabase Auth; database access remains locked by RLS.

# Supabase project (Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Qualified referral domains (comma-separated, lower-case)
REFERRAL_ALLOWED_DOMAINS=gmail.com,hotmail.com,outlook.com,proton.me

# Configure sender address/name and SMTP credentials in Supabase Auth.
# Never store SMTP credentials or service-role keys in source control.
